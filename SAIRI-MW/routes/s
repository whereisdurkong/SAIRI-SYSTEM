//Unique ID Generation

function generateAccidentId() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    let randomPart = '';
    for (let i = 0; i < 6; i++) {
        randomPart += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return `acc${randomPart}`;
}

function generateAccidentId(siriRefType, existingIds) {
    // Determine prefix based on siriRefType
    let prefix;
    if (siriRefType === 'Underground') {
        prefix = 'SUG-AIRI-';
    } else if (siriRefType === 'Surface') {
        prefix = 'SSF-AIRI-';
    } else {
        // Default fallback
        prefix = 'ACC-';
    }

    // Get all existing IDs with the same prefix
    const existingNumbers = existingIds
        .filter(id => id.startsWith(prefix))
        .map(id => {
            const numberPart = id.replace(prefix, '');
            return parseInt(numberPart, 10);
        })
        .filter(num => !isNaN(num));

    // Find the next available number
    let nextNumber = 1;
    if (existingNumbers.length > 0) {
        const sortedNumbers = existingNumbers.sort((a, b) => a - b);
        // Find the first gap in the sequence
        for (let i = 0; i < sortedNumbers.length; i++) {
            if (sortedNumbers[i] !== i + 1) {
                nextNumber = i + 1;
                break;
            }
            nextNumber = sortedNumbers.length + 1;
        }
    }
    return `${prefix}${nextNumber}`;
}

